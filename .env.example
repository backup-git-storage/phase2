# --------------------------------------------------
# LOCAL DEVELOPMENT
# --------------------------------------------------

APP_ENV=development

DATABASE_URL=sqlite:///./dengue.db

# Generate a fresh secret; never use this example as a real secret.
SESSION_SECRET=replace_with_a_random_secret

COOKIE_SECURE=false
SESSION_MAX_AGE=3600


# --------------------------------------------------
# PRODUCTION CONFIGURATION
# --------------------------------------------------
# Configure these values in your hosting provider's environment settings.
# Do not commit real credentials or secrets.

# APP_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# SESSION_SECRET=your_generated_random_secret
# COOKIE_SECURE=true